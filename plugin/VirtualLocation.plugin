#!name=虚拟定位
#!desc=修改 Apple 网络定位返回坐标，实现虚拟定位。在插件设置里填写目标经纬度（独立自研，不修改则原样透传）
#!openUrl=https://github.com/IU19930516YPF/Loon-AdBlock
#!author=IU19930516YPF
#!homepage=https://github.com/IU19930516YPF/Loon-AdBlock
#!icon=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/source/avatar.jpg

# ================================================================
# 虚拟定位 —— Apple 网络定位（gs-loc）坐标修改（独立自研）
#
# 原理：MITM 拦截 gs-loc.apple.com/clls/wloc 的 protobuf 响应，
#       将其中的经纬度替换为你设定的坐标。
#
# 使用：
#   1. 导入本插件并启用
#   2. 在插件设置里填写目标经度 / 纬度（留空 = 透传模式，不修改定位）
#   3. 开启 MITM，并在 iPhone 上信任 Loon 证书
#   4. 也可用地图选点页面选点后"储存到设备"（需当前网络走代理）
#   4. 建议关闭 App 后重进，或开关一次飞行模式，让系统重新请求定位
#
# 注意：
#   - iOS 27 beta 6 起系统禁止对 gs-loc 做 MITM，本插件在该版本上无效
#   - 仅修改网络定位（WiFi/基站），GPS 定位不受影响；
#     如需完全虚拟定位，请同时关闭 WiFi 或在室外注意 GPS 漂移
#   - 未填写坐标时为透传模式，不影响正常定位
# ================================================================

[Argument]
longitude = input, "", tag=目标经度（留空=透传）
latitude = input, "", tag=目标纬度（留空=透传）
accuracy = input, "25", tag=定位精度（米）

[Script]
http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save script-path=https://raw.githubusercontent.com/IU19930516YPF/Loon-AdBlock/main/script/virtual-location-settings.js, timeout=10, tag=虚拟定位-保存接口
http-response ^https?:\/\/(gs-loc(-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(\.gds\.alibabadns\.com)?)\/clls\/wloc script-path=https://raw.githubusercontent.com/IU19930516YPF/Loon-AdBlock/main/script/virtual-location.js, requires-body=true, binary-body-mode=true, timeout=30, tag=虚拟定位, argument=longitude={longitude}&latitude={latitude}&accuracy={accuracy}

[MITM]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
