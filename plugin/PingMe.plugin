#!name=PingMe 签到
#!desc=PingMe 自动签到+视频奖励（自有优化版 v1.2.0：多账号支持 + 30 秒超时 + 失败自动重试 3 次，抓参与签到一体）。订阅后打开 PingMe App 触发一次即自动抓参，每天 08:30、20:30 自动运行。
#!author=豆包（基于 fmz200/奶思 版优化）
#!date=2026-10-21
#!icon=https://uaena.107-174-92-178.nip.io:1443/pingme-checkin/PingMe.png

[Script]
http-request ^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus script-path=https://raw.githubusercontent.com/IU19930516YPF/Loon-AdBlock/main/script/PingMeSignin.js, tag=PingMe抓参, enable=true
cron "30 8,20 * * *" script-path=https://raw.githubusercontent.com/IU19930516YPF/Loon-AdBlock/main/script/PingMeSignin.js, tag=PingMe签到, enable=true

[MITM]
hostname = api.pingmeapp.net
