#!name=不背单词大会员
#!desc=v1.0.3：bb-user-category 的 9 个权益（大会员+柯林斯/词根/派生/近义词/颜值包/单词本等装备）改终身 VIP，App 本地判定、功能真解锁；酷币余额显示改 999999（购买页/明细页）。v1.0.1：权益字段改用 App 自家代码证实的形状（type=svip 终身档 + expire_date）。v1.0.2：购买页改写推广到 gear/purchase（装备购买页），所有 purchased 标志一并置 1。v1.0.3：手动运行/无请求上下文时安静退出不再报 ReferenceError（http-response 脚本不能手动运行）。注意：酷币是服务器记账，真花酷币时服务器按真实余额校验，假余额花不出去；会员身份标识、个人主页显示同步生效。
#!author=Muse（豆包维护）
#!homepage=https://www.learnywhere.cn

[Script]
http-response ^https?:\/\/learnywhere\.cn\/api\/(activity\/common\/bb-user-category|buy\/common\/bb\/(bbvip|gear)\/purchase|bb\/coin-records) script-path=https://raw.githubusercontent.com/IU19930516YPF/Loon-AdBlock/main/script/bbdanci.js, requires-body=true, max-size=1048576, tag=不背单词大会员, enable=true

[MITM]
hostname = learnywhere.cn
